# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public URL of this app (used in share links and auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32-byte key, base64. Encrypts integration tokens and share tokens at rest.
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Protects the scheduled health-check endpoint. Generate: openssl rand -hex 32
CRON_SECRET=
